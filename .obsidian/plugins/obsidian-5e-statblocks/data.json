                          "callback": "const ROLE_XP = {\n  \"Minion\": 5,\n  \"Standard\": 10,\n  \"Elite\": 15,\n  \"Solo\": 25\n};\n\nconst rank = monster.rank ?? \"-\";\nconst level = monster.level ?? \"-\";\nconst role = monster.encounter_role ?? monster.creature_role ?? \"Standard\";\nconst xp = (\"xp\" in monster) ? monster.xp : (ROLE_XP[role] ?? 0);\n\nreturn `${rank} ${level} • ${role} (${xp} XP)`;",
